node_modules/
dist/
build/
coverage/
*.log

# artefato de build: hash de conteúdo de web/dist/widget.js, gerado por
# `npm run build` (web/scripts/gerar-widget-version.mjs). Nunca versionar —
# valor stale no repo mascararia o hash real do build.
.widget-version

# variáveis de ambiente (nunca versionar)
.env
.env.local
**/.env
**/.env.local
**/.env.production

# Prisma engine binário (gerado localmente)
server/src/generated/

# referências locais de design/pesquisa — não versionar
docs/references/

# dumps e backups de banco — nunca versionar, exceto as migrations do Prisma
*.dump
*.bak
*.sql
!server/prisma/migrations/**/*.sql
