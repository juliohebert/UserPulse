# Copie este arquivo para server/.env e ajuste para o seu ambiente.
# Nunca commite server/.env — ele já está no .gitignore.

# ── Banco de dados ────────────────────────────────────────────────────────────

# Desenvolvimento local (Docker Compose)
DATABASE_URL="postgresql://userpulse:userpulse@localhost:5432/userpulse?schema=public"

# Produção com Neon (pooler para conexões)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# Necessário apenas se usar Neon e precisar rodar migrations direto (sem pooler)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ── Servidor ──────────────────────────────────────────────────────────────────

PORT=3333
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origens permitidas para rotas de admin (/api/campanhas e /api/dashboard).
# Separar por vírgula. Se não definido, aceita qualquer origem (dev apenas).
# /api/widget/* é sempre aberto (widget embarcado em sites de clientes).
# CORS_ORIGINS=https://userpulse.seudominio.com,https://admin.seudominio.com

# ── Login admin ───────────────────────────────────────────────────────────────
# Segredo usado pra assinar a sessão (JWT em cookie httpOnly). OBRIGATÓRIO: sem
# isso o servidor nem sobe. Gere com: openssl rand -hex 32
ADMIN_JWT_SECRET=

# Usados só por `npm run db:seed:admin` (server/prisma/seedAdmin.ts) pra criar
# o admin inicial — não são lidos em tempo de execução pelo servidor. Rode o
# script uma vez, depois pode remover estas duas linhas do .env real.
# Se ADMIN_EMAIL já existir no banco, o script só confirma e não faz nada
# (nunca sobrescreve nome/senha de um admin já criado).
# ADMIN_EMAIL=admin@seudominio.com
# ADMIN_PASSWORD=defina-uma-senha-com-8+-caracteres
# ADMIN_NAME=Administrador

# ── Frontend ──────────────────────────────────────────────────────────────────
# Copie para web/.env antes de rodar npm run build --prefix web.
# Necessário apenas se widget.js for servido por domínio diferente do admin.
# VITE_USERPULSE_WIDGET_URL=https://seu-dominio.com/widget.js
# Login admin: não precisa de variável nenhuma aqui — a sessão é um cookie
# httpOnly enviado automaticamente pelo browser (front e back na mesma origem).
