# URL pública do widget.js servido pelo UserPulse.
# Defina para o domínio de produção onde widget.js está acessível.
# Se não definido, usa window.location.origin/widget.js como fallback.
VITE_USERPULSE_WIDGET_URL=https://seu-dominio.com/widget.js

# Token de acesso às rotas admin (/api/campanhas e /api/dashboard).
# Deve ser o mesmo valor que ADMIN_TOKEN no servidor.
# Se não definido, nenhum header Authorization é enviado (dev local).
VITE_ADMIN_TOKEN=seu-token-secreto-aqui
