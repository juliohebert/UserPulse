# URL pública do widget.js servido pelo UserPulse.
# Defina para o domínio de produção onde widget.js está acessível.
# Se não definido, usa window.location.origin/widget.js como fallback.
VITE_USERPULSE_WIDGET_URL=https://seu-dominio.com/widget.js

# Login admin: não precisa de variável nenhuma aqui — a sessão é um cookie
# httpOnly (ver server/.env.example ADMIN_JWT_SECRET), enviado automaticamente
# pelo browser. Front e back precisam estar na mesma origem (produção: mesmo
# servidor Express serve os dois; dev: proxy do Vite pra /api, ver vite.config.ts).
